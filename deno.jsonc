{
  "version": "0.1.0",
  "tasks": {
    "populate": "deno run -A --unstable-fs scripts/populate-lyrics.ts",
    "test": "deno test -A --unstable-fs",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.6",
    "@std/crypto": "jsr:@std/crypto@^1.0.4",
    "@std/async": "jsr:@std/async@^1.0.10",
    "@std/assert": "jsr:@std/assert@^1.0.6",
    "@std/encoding": "jsr:@std/encoding@^1.0.5",
    "@std/cli": "jsr:@std/cli@^1.0.6",
    "music-metadata": "npm:music-metadata@10.6.4",
    "node-id3": "npm:node-id3@0.2.9"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": ["node_modules", ".lyrics-populator-state.json", ".lyrics-populator.log.jsonl"],
  "nodeModulesDir": "auto"
}
